{{!< default}}

<section class="devto-workspace">
  <div class="container">
    <div class="devto-layout-grid">
      {{> "sidebar-left"}}

      <div class="devto-feed-column">
        {{#author}}
          <header class="article-terminal-header devto-context-banner">
            <div class="terminal-card-bar">
              <div class="terminal-dots" aria-hidden="true">
                <span class="dot-red"></span>
                <span class="dot-yellow"></span>
                <span class="dot-green"></span>
              </div>
              <span class="terminal-card-path">~/authors/{{slug}}</span>
              <span class="topic-count-badge">
                {{plural ../pagination.total empty="0 dispatches" singular="% dispatch" plural="% dispatches"}}
              </span>
            </div>

            <div class="article-header-body">
              <div class="devto-author-row">
                <div class="devto-author-avatar" aria-hidden="true">V86</div>
                <div class="devto-author-meta">
                  <h1 class="article-title author-banner-title">
                    {{name}}<span class="cursor-block" aria-hidden="true">&#9612;</span>
                  </h1>
                  <span class="devto-post-date">@{{slug}} &middot; Google Software Engineer</span>
                </div>
              </div>
              {{#if bio}}
                <p class="article-excerpt">{{bio}}</p>
              {{else}}
                <p class="article-excerpt">
                  Software engineer at Google. Writing about systems programming, AI agents, Linux, and hardware builds.
                </p>
              {{/if}}
              <div class="cta-row">
                {{#if website}}
                  <a href="{{website}}" target="_blank" rel="noopener noreferrer" class="btn-terminal">
                    <span class="dollar-muted">$</span>
                    <span>./open_author_site.sh ↗</span>
                  </a>
                {{/if}}
                <a href="{{@site.url}}" class="btn-terminal-secondary">
                  <span class="dollar-muted">$</span>
                  <span>cd ~/blog</span>
                </a>
              </div>
            </div>
          </header>
        {{/author}}

        {{#if posts}}
          <div class="devto-feed-stream" id="feed-stream">
            {{#foreach posts}}
              {{> "post-card"}}
            {{/foreach}}
          </div>
          {{pagination}}
        {{else}}
          {{> "empty-posts"}}
        {{/if}}
      </div>

      {{> "sidebar-right"}}
    </div>
  </div>
</section>
