{{!< default}}

{{#post}}
<article class="{{post_class}} devto-workspace">
  <div class="container">
    <div class="clean-page-wrapper">
      <div class="clean-article-card">
        <div class="clean-article-inner">
          <header class="clean-article-header">
            <h1 class="clean-article-title">{{title}}</h1>
            <p class="clean-article-lead">
              Engineering notes, architecture deep-dives, and hardware garage logs by Vitor Vieira (@vitorecomp).
            </p>
          </header>

          <div class="gh-content gh-canvas">
            {{content}}
          </div>
        </div>
      </div>
    </div>
  </div>
</article>
{{/post}}
