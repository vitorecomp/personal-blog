<aside class="devto-right-rail" aria-label="Author bio and topic channels">
  <div class="terminal-card rail-card">
    <div class="terminal-card-bar">
      <div class="terminal-dots" aria-hidden="true">
        <span class="dot-red"></span>
        <span class="dot-yellow"></span>
        <span class="dot-green"></span>
      </div>
      <span class="terminal-card-path">~$ {{#if @custom.hero_command}}{{@custom.hero_command}}{{else}}whoami{{/if}}</span>
    </div>
    <div class="rail-profile-body">
      <div class="rail-profile-header">
        <div class="rail-avatar-badge" aria-hidden="true">V86</div>
        <div>
          <h2 class="rail-profile-name">Vitor Vieira</h2>
          <p class="rail-profile-handle">@vitorecomp &middot; {{#if @custom.hero_headline}}{{@custom.hero_headline}}{{else}}Engineering Dispatches{{/if}}</p>
        </div>
      </div>

      <p class="rail-profile-bio">
        {{#if @custom.hero_subheadline}}
          {{@custom.hero_subheadline}}
        {{else}}
          Engineering dispatches on systems programming (Rust, Go, C++), autonomous AI agents &amp; MCP, Linux internals, cloud infrastructure, and embedded hardware builds.
        {{/if}}
      </p>

      <dl class="sysinfo-list rail-sysinfo">
        <div class="sysinfo-row">
          <dt>host</dt>
          <dd>blog.vitorx86.dev</dd>
        </div>
        <div class="sysinfo-row">
          <dt>stack</dt>
          <dd>Rust &middot; Go &middot; C++ &middot; Python</dd>
        </div>
        <div class="sysinfo-row">
          <dt>focus</dt>
          <dd>Systems &middot; AI/MCP &middot; Embedded</dd>
        </div>
        <div class="sysinfo-row">
          <dt>posts</dt>
          <dd class="sysinfo-green">
            {{#get "posts" limit="1" as |all_posts post_pages|}}
              {{plural post_pages.total empty="0 published (standby)" singular="% published" plural="% published"}}
            {{/get}}
          </dd>
        </div>
      </dl>

      <div class="rail-profile-actions">
        <a
          href="{{#if @custom.main_site_url}}{{@custom.main_site_url}}{{else}}https://vitorx86.dev{{/if}}"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-terminal rail-btn-full"
          id="rail-cta-vitorx86"
        >
          <span class="dollar-muted">$</span>
          <span>./open_vitorx86.sh ↗</span>
        </a>
        <a
          href="{{#if @custom.portfolio_url}}{{@custom.portfolio_url}}{{else}}https://cases.vitorx86.dev{{/if}}"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-terminal-secondary rail-btn-full"
          id="rail-cta-portfolio"
        >
          <span class="dollar-muted">$</span>
          <span>./browse_86_repos.sh ↗</span>
        </a>
      </div>
    </div>
  </div>

  {{#if @custom.show_topic_channels}}
    <div class="terminal-card rail-card" id="topics">
      <div class="terminal-card-bar">
        <div class="terminal-dots" aria-hidden="true">
          <span class="dot-red"></span>
          <span class="dot-yellow"></span>
          <span class="dot-green"></span>
        </div>
        <span class="terminal-card-path">~/blog/channels</span>
      </div>
      <div class="rail-widget-body">
        <div class="rail-widget-header">
          <h3 class="rail-widget-title">#active_channels</h3>
          <span class="rail-widget-subtitle">topic streams</span>
        </div>
        <div class="rail-channel-list">
          <a href="{{@site.url}}/tag/systems-and-cli/" class="rail-channel-item">
            <span class="rail-channel-tag tag-teal">#systems-and-cli</span>
            <span class="rail-channel-desc">Rust, Go, C++, vector search &amp; Linux CLI</span>
          </a>
          <a href="{{@site.url}}/tag/ai-and-agents/" class="rail-channel-item">
            <span class="rail-channel-tag tag-indigo">#ai-and-agents</span>
            <span class="rail-channel-desc">Autonomous agents, MCP servers &amp; local LLMs</span>
          </a>
          <a href="{{@site.url}}/tag/hardware-and-garage/" class="rail-channel-item">
            <span class="rail-channel-tag tag-pink">#hardware-and-garage</span>
            <span class="rail-channel-desc">ESP32 firmware, CAN-Bus telemetry &amp; robotics</span>
          </a>
          <a href="{{@site.url}}/tag/cloud-and-devops/" class="rail-channel-item">
            <span class="rail-channel-tag tag-teal">#cloud-and-devops</span>
            <span class="rail-channel-desc">GCP, Terraform, Sway/Wayland &amp; Neovim</span>
          </a>
        </div>
      </div>
    </div>
  {{/if}}

  <div class="terminal-card rail-card">
    <div class="terminal-card-bar">
      <div class="terminal-dots" aria-hidden="true">
        <span class="dot-red"></span>
        <span class="dot-yellow"></span>
        <span class="dot-green"></span>
      </div>
      <span class="terminal-card-path">~/cases.vitorx86.dev</span>
    </div>
    <div class="rail-widget-body">
      <div class="rail-widget-header">
        <h3 class="rail-widget-title">./open_source_builds</h3>
        <a
          href="{{#if @custom.portfolio_url}}{{@custom.portfolio_url}}{{else}}https://cases.vitorx86.dev{{/if}}"
          target="_blank"
          rel="noopener noreferrer"
          class="rail-widget-more"
        >
          see all ↗
        </a>
      </div>
      <div class="rail-channel-list">
        <a
          href="{{#if @custom.portfolio_url}}{{@custom.portfolio_url}}{{else}}https://cases.vitorx86.dev{{/if}}"
          target="_blank"
          rel="noopener noreferrer"
          class="rail-channel-item"
        >
          <span class="rail-repo-name">turbovec &amp; ruscene</span>
          <span class="rail-channel-desc">High-performance vector &amp; full-text search in Rust</span>
        </a>
        <a
          href="{{#if @custom.portfolio_url}}{{@custom.portfolio_url}}{{else}}https://cases.vitorx86.dev{{/if}}"
          target="_blank"
          rel="noopener noreferrer"
          class="rail-channel-item"
        >
          <span class="rail-repo-name">go-ls</span>
          <span class="rail-channel-desc">Modern Linux directory listing CLI &amp; telemetry server</span>
        </a>
        <a
          href="{{#if @custom.portfolio_url}}{{@custom.portfolio_url}}{{else}}https://cases.vitorx86.dev{{/if}}"
          target="_blank"
          rel="noopener noreferrer"
          class="rail-channel-item"
        >
          <span class="rail-repo-name">Alissa &amp; MCP Servers</span>
          <span class="rail-channel-desc">Local LLM companion &amp; Model Context Protocol tools</span>
        </a>
      </div>
    </div>
  </div>
</aside>
