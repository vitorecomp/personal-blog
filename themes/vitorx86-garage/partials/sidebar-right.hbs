<aside class="devto-right-rail" aria-label="Industrial engineering datasheet">
  <div class="arc-datasheet">
    <div class="arc-orange-spine" aria-hidden="true">
      <span class="arc-spine-logo">001 v01</span>
      <span class="arc-spine-vertical">Myself spreadsheet</span>
      <span class="arc-spine-arrow">&#8599;</span>
    </div>

    <div class="arc-sheet-main">
      <header class="arc-topbar">
        <span>{{#if @custom.hero_command}}{{@custom.hero_command}}{{else}}V86 / SYSTEMS FOR PRODUCTION{{/if}}</span>
        <span>SERIAL NO. 001</span>
      </header>

      <div class="arc-hero-block" data-hero-headline="{{@custom.hero_headline}}">
        <h2 class="arc-hero-title">
          vitorx86.dev&reg;<br />
          Engineering blog
        </h2>
        <p class="arc-hero-desc">
          {{#if @custom.hero_subheadline}}
            {{@custom.hero_subheadline}}
          {{else}}
            Adaptive systems engineering log by Vitor Vieira (@vitorecomp). Built for low-level performance in Rust, Go, and C++, autonomous AI agents, and embedded garage robotics.
          {{/if}}
        </p>
      </div>

      <div class="arc-diagram-block">
        <div class="arc-diagram-header">
          <h3 class="arc-diagram-title">
            Plug-and-Run<br />Engineering Unit
          </h3>
          <p class="arc-diagram-kicker">
            REAL-TIME AI &amp; SYSTEMS<br />TELEMETRY MODULE
          </p>
        </div>

        <div class="arc-robot-stage">
          <div class="arc-callout arc-callout-tl">
            <span class="arc-callout-title">WRIST UNIT</span>
            <span class="arc-callout-sub">3D printed opensource arm</span>
          </div>
          <div class="arc-callout arc-callout-tr">
            <span class="arc-callout-title">ROBOTIC ARM</span>
            <span class="arc-callout-sub">ESP32 &amp; CAN-Bus hardware</span>
          </div>

          <img
            src="{{asset "images/arc-robot-arm.png"}}"
            alt="P1 Industrial Robotic Arm CAD Diagram"
            class="arc-robot-img"
            loading="lazy"
          />

          <div class="arc-callout arc-callout-bl">
            <span class="arc-callout-title">CONTROLLER STACK</span>
            <span class="arc-callout-sub">Rust, Go &amp; C++ kernels</span>
          </div>
          <div class="arc-callout arc-callout-br">
            <span class="arc-callout-title">DEV STACK</span>
            <span class="arc-callout-sub">Cloud, Linux &amp; Neovim</span>
          </div>
        </div>
      </div>

      <div class="arc-split-grid">
        <a
          href="{{#if @custom.portfolio_url}}{{@custom.portfolio_url}}{{else}}https://cases.vitorx86.dev{{/if}}"
          target="_blank"
          rel="noopener noreferrer"
          class="arc-split-cell"
        >
          <span class="arc-cell-kicker">PRECISION ENGINEERED</span>
          <h4 class="arc-cell-title">Cases &#8599;</h4>
          <p class="arc-cell-desc">
            80+ open-source repositories documented across systems, AI, and hardware.
          </p>
        </a>

        <a
          href="{{#if @custom.main_site_url}}{{@custom.main_site_url}}{{else}}https://vitorx86.dev{{/if}}"
          target="_blank"
          rel="noopener noreferrer"
          class="arc-split-cell"
        >
          <span class="arc-cell-kicker">FACTORY READY</span>
          <h4 class="arc-cell-title">Control &#8599;</h4>
          <p class="arc-cell-desc">
            Main vitorx86.dev workstation, architecture specs, and direct contact.
          </p>
        </a>
      </div>

      <div class="arc-spec-section" id="topics" data-show-topics="{{@custom.show_topic_channels}}">
        <div class="arc-spec-header">
          <span>CHANNEL</span>
          <span>SPEC</span>
          <span>OUTPUT</span>
        </div>

        <div class="arc-spec-row">
          <span class="arc-spec-key">DISPATCH</span>
          <span class="arc-spec-val">
            {{#get "posts" limit="1" as |all_posts post_pages|}}
              {{plural post_pages.total empty="0 PUBLISHED" singular="% PUBLISHED" plural="% PUBLISHED"}}
            {{/get}}
          </span>
          <span class="arc-spec-out">CONTINUOUS DUTY</span>
        </div>
        <div class="arc-spec-row">
          <span class="arc-spec-key">ENGINEER</span>
          <span class="arc-spec-val">VITOR VIEIRA</span>
          <span class="arc-spec-out">GOOGLE SWE</span>
        </div>
      </div>
    </div>
  </div>
</aside>
