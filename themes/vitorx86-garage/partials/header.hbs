<header class="site-header" role="banner">
  <div class="container header-inner">
    <div class="header-left">
      <a href="{{@site.url}}" class="brand-lockup" id="nav-brand-link" aria-label="{{@site.title}} — Home">
        <span class="prompt-prefix">~$</span>
        <span class="prompt-cmd">cd</span>
        <span class="prompt-path">~/vitorx86/blog</span>
        <span class="cursor-block" aria-hidden="true">&#9612;</span>
      </a>

      <form
        class="header-search-bar"
        id="header-search-form"
        role="search"
        action="{{@site.url}}"
        method="get"
      >
        <svg
          class="search-bar-icon"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
          />
        </svg>
        <input
          type="search"
          name="q"
          id="nav-search-input"
          class="header-search-input"
          placeholder='$ grep -i "search dispatches, tags, topics..."'
          aria-label="Search blog articles"
          autocomplete="off"
        />
        <kbd class="kbd-hint" aria-hidden="true">/</kbd>
      </form>
    </div>

    <div class="header-actions">
      <nav class="desktop-nav" aria-label="Quick Links">
        <a href="{{@site.url}}" class="nav-exec-link" id="nav-link-dispatches">
          <span class="slash-prefix">./</span>feed
        </a>
        <a href="{{@site.url}}/about/" class="nav-exec-link" id="nav-link-about">
          <span class="slash-prefix">./</span>about
        </a>
        <a
          href="{{#if @custom.portfolio_url}}{{@custom.portfolio_url}}{{else}}https://cases.vitorx86.dev{{/if}}"
          target="_blank"
          rel="noopener noreferrer"
          class="nav-exec-link"
          id="nav-link-portfolio"
        >
          <span class="slash-prefix">./</span>portfolio
        </a>
        <a
          href="{{#if @custom.main_site_url}}{{@custom.main_site_url}}{{else}}https://vitorx86.dev{{/if}}"
          target="_blank"
          rel="noopener noreferrer"
          class="nav-exec-link"
          id="nav-link-main-site"
        >
          <span class="slash-prefix">./</span>vitorx86.dev
        </a>
      </nav>

      {{#if @member}}
        <a
          href="#/portal/account"
          data-portal="account"
          class="terminal-pill-btn"
          id="nav-account-btn"
          title="Member account settings"
        >
          <span class="dollar-muted">$</span>
          <span>./account</span>
        </a>
      {{else}}
        <a
          href="#/portal/signin"
          data-portal="signin"
          class="terminal-pill-btn"
          id="nav-login-btn"
          title="Sign in to blog"
        >
          <span class="dollar-muted">$</span>
          <span>./login</span>
        </a>
      {{/if}}

      <button
        type="button"
        class="terminal-pill-btn"
        id="theme-toggle-btn"
        aria-label="Toggle color scheme"
        title="Toggle light/dark terminal theme"
      >
        <span class="dollar-muted">$</span>
        <span class="theme-toggle-label" id="theme-toggle-text">--dark</span>
      </button>

      <button
        type="button"
        class="terminal-pill-btn mobile-menu-trigger"
        id="mobile-menu-button"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open navigation drawer"
      >
        <svg
          class="icon-sm"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
          />
        </svg>
        <span><span class="dollar-muted">$&nbsp;</span>ls</span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu-drawer hidden" role="region" aria-label="Mobile Navigation">
    <div class="container">
      <div class="terminal-links-panel">
        <p class="terminal-panel-caption">$ ls -la ~/vitorx86/blog/nav</p>
        <div class="mobile-links-list">
          <a href="{{@site.url}}" class="terminal-panel-link" id="mobile-link-dispatches">
            <span class="slash-prefix">./</span>home_feed
          </a>
          <a href="{{@site.url}}/#topics" class="terminal-panel-link" id="mobile-link-topics">
            <span class="slash-prefix">./</span>topics
          </a>
          <a href="{{@site.url}}/about/" class="terminal-panel-link" id="mobile-link-about">
            <span class="slash-prefix">./</span>about
          </a>
          <a
            href="{{#if @custom.portfolio_url}}{{@custom.portfolio_url}}{{else}}https://cases.vitorx86.dev{{/if}}"
            target="_blank"
            rel="noopener noreferrer"
            class="terminal-panel-link"
            id="mobile-link-portfolio"
          >
            <span class="slash-prefix">./</span>portfolio ↗
          </a>
          <a
            href="{{#if @custom.main_site_url}}{{@custom.main_site_url}}{{else}}https://vitorx86.dev{{/if}}"
            target="_blank"
            rel="noopener noreferrer"
            class="terminal-panel-link"
            id="mobile-link-vitorx86"
          >
            <span class="slash-prefix">./</span>vitorx86.dev ↗
          </a>
          <a
            href="{{#if @custom.github_url}}{{@custom.github_url}}{{else}}https://github.com/vitorecomp{{/if}}"
            target="_blank"
            rel="noopener noreferrer"
            class="terminal-panel-link"
            id="mobile-link-github"
          >
            <span class="slash-prefix">./</span>github ↗
          </a>
          <a
            href="{{@site.url}}/rss/"
            target="_blank"
            rel="noopener noreferrer"
            class="terminal-panel-link"
            id="mobile-link-rss"
          >
            <span class="slash-prefix">./</span>rss
          </a>
          {{#if @member}}
            <a href="#/portal/account" data-portal="account" class="terminal-panel-link" id="mobile-link-account">
              <span class="slash-prefix">./</span>account
            </a>
          {{else}}
            <a href="#/portal/signin" data-portal="signin" class="terminal-panel-link" id="mobile-link-login">
              <span class="slash-prefix">./</span>login
            </a>
          {{/if}}
        </div>
      </div>
    </div>
  </div>
</header>
