<article
  class="{{post_class}} clean-feed-card devto-feed-card{{#if featured}} is-featured{{/if}}{{#if @first}} is-first-story{{/if}}"
  data-post-slug="{{slug}}"
  data-post-featured="{{#if featured}}true{{else}}false{{/if}}"
  data-post-tags="{{#foreach tags}}{{slug}} {{/foreach}}"
>
  {{#if feature_image}}
    <a href="{{url}}" class="terminal-card-image-link" aria-hidden="true" tabindex="-1">
      <img
        class="terminal-card-image"
        srcset="{{img_url feature_image size="s"}} 300w,
                {{img_url feature_image size="m"}} 600w,
                {{img_url feature_image size="l"}} 1000w"
        sizes="(max-width: 768px) 100vw, 720px"
        src="{{img_url feature_image size="l"}}"
        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
        loading="lazy"
      />
    </a>
  {{/if}}

  <div class="clean-feed-card-body">
    <div class="devto-author-row">
      {{#primary_author}}
        <a href="{{url}}" class="devto-author-avatar" aria-label="{{name}}">
          {{#if profile_image}}
            <img src="{{img_url profile_image size="xs"}}" alt="{{name}}" class="devto-avatar-img" />
          {{else}}
            <span>V86</span>
          {{/if}}
        </a>
        <div class="devto-author-meta">
          <a href="{{url}}" class="clean-author-name">{{name}}</a>
          <span class="clean-post-date">
            <time datetime="{{../date format="YYYY-MM-DD"}}">{{../date format="MMM DD, YYYY"}}</time>
          </span>
        </div>
      {{/primary_author}}

      {{#if featured}}
        <span class="clean-pinned-badge">Pinned</span>
      {{/if}}
    </div>

    <div class="devto-card-indented">
      <h2 class="clean-feed-title">
        <a href="{{url}}" class="clean-feed-title-link">{{title}}</a>
      </h2>

      {{#if tags}}
        <div class="clean-tag-row">
          {{#foreach tags}}
            <a href="{{url}}" class="clean-tag-chip">
              #{{slug}}
            </a>
          {{/foreach}}
        </div>
      {{/if}}

      {{#if excerpt}}
        <p class="clean-feed-excerpt">{{excerpt words="36"}}</p>
      {{/if}}

      <div class="clean-feed-footer">
        <a href="{{url}}" class="clean-read-link">
          <span>Read article</span>
          <span class="action-arrow" aria-hidden="true">&rarr;</span>
        </a>

        <div class="devto-card-Utils">
          {{#if reading_time}}
            <span class="clean-reading-time">{{reading_time}}</span>
          {{/if}}
          <button
            type="button"
            class="clean-save-btn feed-save-btn"
            data-save-slug="{{slug}}"
            aria-label="Save {{title}} to reading list"
            title="Save to reading list"
          >
            <svg class="save-icon-svg" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0Z" />
            </svg>
            <span class="save-btn-label">Save</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</article>
