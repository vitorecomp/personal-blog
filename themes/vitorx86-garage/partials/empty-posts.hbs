<div class="terminal-empty-window" id="empty-posts-console" role="status" aria-live="polite">
  <div class="terminal-card-bar">
    <div class="terminal-dots" aria-hidden="true">
      <span class="dot-red"></span>
      <span class="dot-yellow"></span>
      <span class="dot-green"></span>
    </div>
    <span class="terminal-card-path">vitor@vitorx86:~/blog/feed$ ls -la</span>
    <span class="terminal-status-badge">[0 posts in stream]</span>
  </div>

  <div class="terminal-empty-body">
    <div class="devto-author-row empty-author-row">
      <div class="devto-author-avatar" aria-hidden="true">V86</div>
      <div class="devto-author-meta">
        <span class="devto-author-name">Vitor Vieira (@vitorecomp)</span>
        <span class="devto-post-date">stream status: standby &middot; waiting for first dispatch</span>
      </div>
    </div>

    <div class="terminal-log-lines">
      <p class="log-cmd">
        <span class="dollar-muted">~$&nbsp;</span>
        <span class="cmd-teal">ls -la ~/blog/posts</span>
      </p>
      <pre class="log-output">total 0
drwxr-xr-x  2 vitor vitor 4096 {{date format="MMM DD HH:mm"}} .
drwxr-xr-x  6 vitor vitor 4096 {{date format="MMM DD HH:mm"}} ..</pre>

      <div class="empty-status-box">
        <h3 class="empty-status-title">
          # No Dispatches Published in This Feed Yet
        </h3>
        <p class="empty-status-desc">
          The <strong>vitorx86.dev</strong> Ghost publication stream is online.
          Upcoming articles will appear here in chronological feed order covering
          <strong>#systems-and-cli</strong> (Rust, Go, C++), <strong>#ai-and-agents</strong> (MCP, LLMs),
          <strong>#hardware-and-garage</strong> (ESP32, CAN-Bus), and <strong>#cloud-and-devops</strong> (GCP, Linux, Neovim).
        </p>
      </div>
    </div>

    <div class="empty-actions-row">
      <div class="cta-row">
        <a
          href="{{#if @custom.portfolio_url}}{{@custom.portfolio_url}}{{else}}https://cases.vitorx86.dev{{/if}}"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-terminal"
          id="empty-cta-portfolio"
        >
          <span class="dollar-muted">$</span>
          <span>./explore_project_docs.sh ↗</span>
        </a>
        <a
          href="{{@site.url}}/rss/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-terminal-secondary"
          id="empty-cta-rss"
        >
          <span class="dollar-muted">$</span>
          <span>./subscribe_rss.sh</span>
        </a>
      </div>
    </div>
  </div>
</div>
