{{!< default}}

<section class="devto-workspace" aria-label="Blog feed and channels">
  <div class="container">
    <div class="devto-layout-grid">
      {{> "sidebar-left"}}

      <div class="devto-feed-column" id="dispatches">
        <header class="devto-feed-header">
          <div class="devto-feed-tabs" role="tablist" aria-label="Feed sort and filter">
            <button
              type="button"
              class="feed-tab is-active"
              role="tab"
              aria-selected="true"
              data-feed-filter="all"
              id="feed-tab-latest"
            >
              <span class="slash-prefix">./</span>latest
            </button>
            <button
              type="button"
              class="feed-tab"
              role="tab"
              aria-selected="false"
              data-feed-filter="featured"
              id="feed-tab-featured"
            >
              <span class="slash-prefix">./</span>featured
            </button>
            <button
              type="button"
              class="feed-tab"
              role="tab"
              aria-selected="false"
              data-feed-filter="saved"
              id="feed-tab-saved"
            >
              <span class="slash-prefix">./</span>reading_list
            </button>
          </div>

          <div class="section-meta-pill">
            <span class="dollar-muted">$</span>
            <span>{{plural pagination.total empty="0 posts" singular="% post" plural="% posts"}}</span>
          </div>
        </header>

        {{#if posts}}
          <div class="devto-feed-stream" id="feed-stream">
            {{#foreach posts}}
              {{> "post-card"}}
            {{/foreach}}
          </div>

          <div class="terminal-card feed-filter-empty hidden" id="feed-filter-empty" role="status">
            <div class="terminal-card-bar">
              <span class="terminal-card-path">~/blog/feed$ grep</span>
            </div>
            <div class="terminal-card-body">
              <p class="terminal-card-excerpt" id="feed-filter-empty-text">
                No matching dispatches in this view yet.
              </p>
            </div>
          </div>

          {{pagination}}
        {{else}}
          {{> "empty-posts"}}
        {{/if}}
      </div>

      {{> "sidebar-right"}}
    </div>
  </div>
</section>
