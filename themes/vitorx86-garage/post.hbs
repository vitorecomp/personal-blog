{{!< default}}

{{#post}}
<article class="{{post_class}} devto-workspace">
  <div class="reading-progress-bar" id="reading-progress-bar" aria-hidden="true"></div>

  <div class="container">
    <div class="devto-article-grid">
      <aside class="devto-article-actions" aria-label="Article quick actions">
        <div class="article-action-rail">
          <button
            type="button"
            class="action-rail-btn feed-save-btn"
            data-save-slug="{{slug}}"
            aria-label="Save article to reading list"
            title="Save to reading list"
          >
            <svg class="action-rail-svg" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0Z" />
            </svg>
            <span class="save-btn-label action-rail-label">Save</span>
          </button>

          <button
            type="button"
            class="action-rail-btn"
            id="copy-article-url-btn"
            data-url="{{url absolute="true"}}"
            aria-label="Copy article link"
            title="Copy article URL"
          >
            <svg class="action-rail-svg" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
            </svg>
            <span class="action-rail-label" id="copy-article-url-text">Copy</span>
          </button>

          <a
            href="{{@site.url}}"
            class="action-rail-btn"
            id="back-to-blog-rail-btn"
            aria-label="Back to feed"
            title="Back to feed"
          >
            <svg class="action-rail-svg" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
            </svg>
            <span class="action-rail-label">Feed</span>
          </a>
        </div>
      </aside>

      <div class="devto-article-main">
        <div class="clean-article-card">
          {{#if feature_image}}
            <figure class="article-cover-figure">
              <img
                srcset="{{img_url feature_image size="s"}} 300w,
                        {{img_url feature_image size="m"}} 600w,
                        {{img_url feature_image size="l"}} 1000w,
                        {{img_url feature_image size="xl"}} 1600w"
                sizes="(max-width: 1120px) 100vw, 800px"
                src="{{img_url feature_image size="xl"}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                class="article-feature-image"
              />
              {{#if feature_image_caption}}
                <figcaption class="article-feature-caption">{{feature_image_caption}}</figcaption>
              {{/if}}
            </figure>
          {{/if}}

          <div class="clean-article-inner">
            <header class="clean-article-header">
              <div class="devto-author-row article-author-row">
                {{#primary_author}}
                  <a href="{{url}}" class="devto-author-avatar" aria-label="{{name}}">
                    {{#if profile_image}}
                      <img src="{{img_url profile_image size="xs"}}" alt="{{name}}" class="devto-avatar-img" />
                    {{else}}
                      <span>V86</span>
                    {{/if}}
                  </a>
                  <div class="devto-author-meta">
                    <a href="{{url}}" class="clean-author-name">{{name}}</a>
                    <span class="clean-post-date">
                      Posted on <time datetime="{{../date format="YYYY-MM-DD"}}">{{../date format="MMM DD, YYYY"}}</time>
                      {{#if ../reading_time}} &middot; {{../reading_time}}{{/if}}
                    </span>
                  </div>
                {{/primary_author}}
              </div>

              <h1 class="clean-article-title">{{title}}</h1>

              {{#if tags}}
                <div class="clean-tag-row">
                  {{#foreach tags}}
                    <a href="{{url}}" class="clean-tag-chip">
                      #{{slug}}
                    </a>
                  {{/foreach}}
                </div>
              {{/if}}

              {{#if custom_excerpt}}
                <p class="clean-article-lead">{{custom_excerpt}}</p>
              {{/if}}
            </header>

            <div class="gh-content gh-canvas" id="article-prose-content">
              {{content}}
            </div>
          </div>
        </div>

        <footer class="article-footer">
          <div class="clean-share-card">
            <div>
              <h3 class="clean-share-title">Enjoyed this article?</h3>
              <p class="clean-share-copy">
                Save it to your reading list or subscribe to the RSS feed for future engineering dispatches.
              </p>
            </div>
            <div class="cta-row">
              <a href="{{@site.url}}/rss/" target="_blank" rel="noopener noreferrer" class="clean-btn-primary">
                Subscribe via RSS
              </a>
              <a href="{{@site.url}}" class="clean-btn-secondary" id="back-to-blog-btn">
                &larr; Back to Feed
              </a>
            </div>
          </div>

          {{#if comments}}
            <section class="article-comments-section" aria-label="Comments">
              {{comments}}
            </section>
          {{/if}}

          <nav class="post-adjacent-nav" aria-label="More articles">
            {{#prev_post}}
              <a href="{{url}}" class="clean-adjacent-card" id="prev-post-link">
                <span class="clean-adjacent-label">&larr; Previous article</span>
                <h3 class="clean-adjacent-title">{{title}}</h3>
              </a>
            {{/prev_post}}
            {{#next_post}}
              <a href="{{url}}" class="clean-adjacent-card" id="next-post-link">
                <span class="clean-adjacent-label">Next article &rarr;</span>
                <h3 class="clean-adjacent-title">{{title}}</h3>
              </a>
            {{/next_post}}
          </nav>
        </footer>
      </div>

      <aside class="devto-article-sidebar" aria-label="Author info and table of contents">
        <div class="article-sticky-stack">
          {{#primary_author}}
            <div class="clean-sidebar-card">
              <div class="clean-sidebar-accent"></div>
              <div class="clean-sidebar-body">
                <div class="rail-profile-header">
                  <div class="devto-author-avatar" aria-hidden="true">V86</div>
                  <div>
                    <h2 class="clean-sidebar-author-name">
                      <a href="{{url}}">{{name}}</a>
                    </h2>
                    <p class="clean-sidebar-author-role">@{{slug}} &middot; Google SWE</p>
                  </div>
                </div>
                <p class="clean-sidebar-bio">
                  {{#if bio}}
                    {{bio}}
                  {{else}}
                    Systems programming (Rust, Go, C++), autonomous AI agents &amp; MCP, Linux internals, cloud infrastructure, and embedded hardware builds.
                  {{/if}}
                </p>
                <a
                  href="{{#if @custom.main_site_url}}{{@custom.main_site_url}}{{else}}https://vitorx86.dev{{/if}}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="clean-btn-primary rail-btn-full"
                >
                  Visit vitorx86.dev ↗
                </a>
              </div>
            </div>
          {{/primary_author}}

          <div class="clean-sidebar-card" id="article-toc-aside" hidden>
            <div class="clean-sidebar-body">
              <h3 class="clean-toc-heading">On this page</h3>
              <nav class="clean-toc-nav" id="article-toc-nav" aria-label="Article sections"></nav>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</article>
{{/post}}
