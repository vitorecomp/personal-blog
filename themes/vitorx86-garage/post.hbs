{{!< default}}

{{#post}}
<article class="{{post_class}} devto-workspace">
  <div class="reading-progress-bar" id="reading-progress-bar" aria-hidden="true"></div>

  <div class="container">
    <div class="devto-article-grid">
      <aside class="devto-article-actions" aria-label="Article quick actions">
        <div class="article-action-rail">
          <button
            type="button"
            class="action-rail-btn feed-save-btn"
            data-save-slug="{{slug}}"
            aria-label="Save article to reading list"
            title="Save to reading list"
          >
            <span class="action-rail-icon" aria-hidden="true">[+]</span>
            <span class="save-btn-label action-rail-label">save</span>
          </button>

          <button
            type="button"
            class="action-rail-btn"
            id="copy-article-url-btn"
            data-url="{{url absolute="true"}}"
            aria-label="Copy article link"
            title="Copy article URL"
          >
            <span class="action-rail-icon" aria-hidden="true">cp</span>
            <span class="action-rail-label" id="copy-article-url-text">url</span>
          </button>

          <a
            href="{{@site.url}}"
            class="action-rail-btn"
            id="back-to-blog-rail-btn"
            aria-label="Back to feed"
            title="Back to feed"
          >
            <span class="action-rail-icon" aria-hidden="true">&larr;</span>
            <span class="action-rail-label">feed</span>
          </a>
        </div>
      </aside>

      <div class="devto-article-main">
        <header class="article-terminal-header">
          <div class="terminal-card-bar">
            <div class="terminal-dots" aria-hidden="true">
              <span class="dot-red"></span>
              <span class="dot-yellow"></span>
              <span class="dot-green"></span>
            </div>
            <span class="terminal-card-path">
              ~/blog/{{#if primary_tag}}{{primary_tag.slug}}/{{/if}}{{slug}}.md
            </span>
            <span class="terminal-card-meta">
              <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="YYYY-MM-DD"}}</time>
              {{#if reading_time}} &middot; {{reading_time}}{{/if}}
            </span>
          </div>

          {{#if feature_image}}
            <figure class="article-cover-figure">
              <img
                srcset="{{img_url feature_image size="s"}} 300w,
                        {{img_url feature_image size="m"}} 600w,
                        {{img_url feature_image size="l"}} 1000w,
                        {{img_url feature_image size="xl"}} 1600w"
                sizes="(max-width: 1120px) 100vw, 800px"
                src="{{img_url feature_image size="xl"}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                class="article-feature-image"
              />
              {{#if feature_image_caption}}
                <figcaption class="article-feature-caption">{{feature_image_caption}}</figcaption>
              {{/if}}
            </figure>
          {{/if}}

          <div class="article-header-body">
            <div class="devto-author-row article-author-row">
              {{#primary_author}}
                <a href="{{url}}" class="devto-author-avatar" aria-label="{{name}}">
                  {{#if profile_image}}
                    <img src="{{img_url profile_image size="xs"}}" alt="{{name}}" class="devto-avatar-img" />
                  {{else}}
                    <span>V86</span>
                  {{/if}}
                </a>
                <div class="devto-author-meta">
                  <a href="{{url}}" class="devto-author-name">{{name}}</a>
                  <span class="devto-post-date">
                    Posted on <time datetime="{{../date format="YYYY-MM-DD"}}">{{../date format="MMM DD, YYYY"}}</time>
                    {{#if ../reading_time}} &middot; {{../reading_time}}{{/if}}
                  </span>
                </div>
              {{/primary_author}}
            </div>

            <h1 class="article-title">{{title}}</h1>

            {{#if tags}}
              <div class="terminal-card-tags article-tag-row">
                {{#foreach tags}}
                  <a
                    href="{{url}}"
                    class="tag-chip {{#match slug "ai-and-agents"}}tag-indigo{{else match slug "hardware-and-garage"}}tag-pink{{else}}tag-teal{{/match}}"
                  >
                    #{{slug}}
                  </a>
                {{/foreach}}
              </div>
            {{/if}}

            {{#if custom_excerpt}}
              <p class="article-excerpt">{{custom_excerpt}}</p>
            {{/if}}
          </div>
        </header>

        <div class="devto-prose-card">
          <div class="gh-content gh-canvas" id="article-prose-content">
            {{content}}
          </div>
        </div>

        <footer class="article-footer">
          <div class="terminal-card article-share-card">
            <div class="terminal-card-bar">
              <div class="terminal-dots" aria-hidden="true">
                <span class="dot-red"></span>
                <span class="dot-yellow"></span>
                <span class="dot-green"></span>
              </div>
              <span class="terminal-card-path">~/blog/eof.sh</span>
            </div>
            <div class="article-share-body">
              <div>
                <p class="share-copy">
                  Enjoyed this dispatch? Save it to your reading list or subscribe via RSS.
                </p>
              </div>
              <div class="cta-row">
                <a href="{{@site.url}}/rss/" target="_blank" rel="noopener noreferrer" class="btn-terminal">
                  <span class="dollar-muted">$</span>
                  <span>./subscribe_rss.sh</span>
                </a>
                <a href="{{@site.url}}" class="btn-terminal-secondary" id="back-to-blog-btn">
                  <span class="dollar-muted">$</span>
                  <span>cd ~/blog</span>
                </a>
              </div>
            </div>
          </div>

          {{#if comments}}
            <section class="article-comments-section" aria-label="Comments">
              {{comments}}
            </section>
          {{/if}}

          <nav class="post-adjacent-nav" aria-label="Adjacent dispatches">
            {{#prev_post}}
              <a href="{{url}}" class="terminal-card adjacent-card" id="prev-post-link">
                <div class="terminal-card-bar">
                  <span class="terminal-card-path">&larr; prev_dispatch.sh</span>
                </div>
                <div class="terminal-card-body">
                  <h3 class="terminal-card-title">{{title}}</h3>
                </div>
              </a>
            {{/prev_post}}
            {{#next_post}}
              <a href="{{url}}" class="terminal-card adjacent-card" id="next-post-link">
                <div class="terminal-card-bar">
                  <span class="terminal-card-path">next_dispatch.sh &rarr;</span>
                </div>
                <div class="terminal-card-body">
                  <h3 class="terminal-card-title">{{title}}</h3>
                </div>
              </a>
            {{/next_post}}
          </nav>
        </footer>
      </div>

      <aside class="devto-article-sidebar" aria-label="Author info and table of contents">
        <div class="article-sticky-stack">
          {{#primary_author}}
            <div class="terminal-card rail-card">
              <div class="terminal-card-bar">
                <div class="terminal-dots" aria-hidden="true">
                  <span class="dot-red"></span>
                  <span class="dot-yellow"></span>
                  <span class="dot-green"></span>
                </div>
                <span class="terminal-card-path">~/authors/{{slug}}</span>
              </div>
              <div class="rail-profile-body">
                <div class="rail-profile-header">
                  <div class="rail-avatar-badge" aria-hidden="true">V86</div>
                  <div>
                    <h2 class="rail-profile-name">
                      <a href="{{url}}">{{name}}</a>
                    </h2>
                    <p class="rail-profile-handle">@{{slug}} &middot; Google SWE</p>
                  </div>
                </div>
                <p class="rail-profile-bio">
                  {{#if bio}}
                    {{bio}}
                  {{else}}
                    Systems programming (Rust, Go, C++), autonomous AI agents &amp; MCP, Linux internals, cloud infrastructure, and embedded hardware builds.
                  {{/if}}
                </p>
                <div class="rail-profile-actions">
                  <a
                    href="{{#if @custom.main_site_url}}{{@custom.main_site_url}}{{else}}https://vitorx86.dev{{/if}}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-terminal rail-btn-full"
                  >
                    <span class="dollar-muted">$</span>
                    <span>./vitorx86.dev ↗</span>
                  </a>
                </div>
              </div>
            </div>
          {{/primary_author}}

          <div class="terminal-card toc-card" id="article-toc-aside" hidden>
            <div class="terminal-card-bar">
              <div class="terminal-dots" aria-hidden="true">
                <span class="dot-red"></span>
                <span class="dot-yellow"></span>
                <span class="dot-green"></span>
              </div>
              <span class="terminal-card-path">~$ cat ./toc.txt</span>
            </div>
            <nav class="toc-body" id="article-toc-nav" aria-label="Article sections"></nav>
          </div>
        </div>
      </aside>
    </div>
  </div>
</article>
{{/post}}
