{{!< default}}

{{#post}}
<article class="{{post_class}} article-shell">
  <div class="container">
    {{#match @page.show_title_and_feature_image}}
      <header class="article-terminal-header">
        <div class="terminal-card-bar">
          <div class="terminal-dots" aria-hidden="true">
            <span class="dot-red"></span>
            <span class="dot-yellow"></span>
            <span class="dot-green"></span>
          </div>
          <span class="terminal-card-path">~/blog/{{slug}}.md</span>
        </div>

        <div class="article-header-body">
          <p class="eyebrow-lockup eyebrow-on-dark">
            <span class="eyebrow-prefix-dark">~$&nbsp;</span>cat ./{{slug}}.md
          </p>
          <h1 class="article-title">{{title}}</h1>
          {{#if custom_excerpt}}
            <p class="article-excerpt">{{custom_excerpt}}</p>
          {{/if}}
        </div>
      </header>

      {{#if feature_image}}
        <figure class="article-feature-figure">
          <img
            srcset="{{img_url feature_image size="s"}} 300w,
                    {{img_url feature_image size="m"}} 600w,
                    {{img_url feature_image size="l"}} 1000w,
                    {{img_url feature_image size="xl"}} 1600w"
            sizes="(max-width: 1120px) 100vw, 1120px"
            src="{{img_url feature_image size="xl"}}"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
            class="article-feature-image"
          />
          {{#if feature_image_caption}}
            <figcaption class="article-feature-caption">{{feature_image_caption}}</figcaption>
          {{/if}}
        </figure>
      {{/if}}
    {{/match}}

    <div class="gh-content gh-canvas">
      {{content}}
    </div>
  </div>
</article>
{{/post}}
