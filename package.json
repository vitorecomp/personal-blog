{
  "name": "personal-blog",
  "version": "1.0.0",
  "private": true,
  "description": "vitorx86.dev // blog — Personal technology blog powered by Ghost 5 and the custom 'vitorx86-garage' terminal theme.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate-theme.mjs",
    "package": "node scripts/validate-theme.mjs && node scripts/package-theme.mjs",
    "build": "node scripts/validate-theme.mjs && node scripts/package-theme.mjs",
    "docker:up": "docker compose up --build -d",
    "docker:dev": "docker compose --profile dev up --build dev",
    "docker:down": "docker compose --profile dev down",
    "podman:up": "podman-compose -f podman-compose.yml up --build -d",
    "podman:dev": "podman-compose -f podman-compose.yml --profile dev up --build dev",
    "podman:down": "podman-compose -f podman-compose.yml --profile dev down"
  }
}
